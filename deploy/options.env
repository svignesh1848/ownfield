# Server options applied by deploy/server-hook.sh on the hosted EC2 server (native PostgreSQL, see deploy/README.md).
# BI_DB_EXPOSE=1 lets Postgres accept outside connections ONLY for enabled ff_bi_c<id> logins, ONLY from the IPs an admin
# entered in Data workspace -> Access, ONLY over TLS (hostssl + scram-sha-256). Default off. The AWS security group must
# also allow the port only from those IPs.
BI_DB_EXPOSE=0
BI_DB_PORT=5432
