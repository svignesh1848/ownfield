# Server options applied by deploy/server-hook.sh on the hosted EC2 server (native PostgreSQL, see deploy/README.md).
# BI_DB_EXPOSE=1 lets Postgres accept outside connections ONLY for enabled ff_bi_c<id> logins, ONLY from the IPs an admin
# entered in Data workspace -> Access, ONLY over TLS (hostssl + scram-sha-256). Default off. The AWS security group must
# also allow the port only from those IPs.
BI_DB_EXPOSE=0
BI_DB_PORT=5432
# Off-server backups (see docs/SECURITY-OPERATIONS.md). The app copies each nightly pg_dump to
# s3://$BACKUP_S3_BUCKET/fieldforce/ with the EC2 instance role (no keys on the server), skipping the upload when the
# data has not changed (a new copy is still kept at least once every 7 days). Bucket: private, SSE-S3,
# versioning + 35-day expiry. These lines reach the app through a systemd drop-in written by server-hook.sh.
BACKUP_S3_BUCKET=ownfield-db-backups-07c8c9
AWS_DEFAULT_REGION=ap-south-1
